# Copy this file to `.env` and adjust. `.env` is gitignored — keep real secrets there.
# docker compose reads `.env` automatically; the Python scripts read it too.

# --- Database (used by the stack) ---
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=zabbix
POSTGRES_DB=zabbix

# --- Frontend ---
ZBX_WEB_PORT=8080
PHP_TZ=UTC

# --- Python automation (used by scripts/) ---
ZABBIX_URL=http://localhost:8080

# Preferred: an API token created under Administration -> API tokens in the frontend.
# Leave blank to fall back to username/password login below.
ZABBIX_TOKEN=

# Fallback login (the default frontend credentials after first start).
# Change ZABBIX_PASSWORD once you change the Admin password in the UI.
ZABBIX_USER=Admin
ZABBIX_PASSWORD=zabbix
